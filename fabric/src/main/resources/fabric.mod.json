{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${mod_version}",
	"name": "WynnVitrail",
	"description": "Vitrail - OptiFine-format shader packs on Minecraft's native Vulkan renderer - with native Wynncraft support",
	"authors": [
		"avpbynf",
		"WynnVitrail fork"
	],
	"contact": {
		"homepage": "https://github.com/avpbynf/Vitrail-Shaders",
		"sources": "https://github.com/avpbynf/Vitrail-Shaders",
		"issues": "https://github.com/avpbynf/Vitrail-Shaders/issues"
	},
	"license": "LGPL-3.0-only",
	"icon": "vitrail.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"dev.vitrail.fabric.VitrailFabric"
		],
		"sodium:config_api_user": [
			"dev.vitrail.sodium.ConfigEntry"
		]
	},
	"mixins": [
		"vitrail.mixins.json",
		"vitrail-game.mixins.json",
		"vitrail-fabric.mixins.json"
	],
	"provides": [
		"vitrail"
	],
	"depends": {
		"fabricloader": ">=${fabric_loader_min_version}",
		"minecraft": ">=${minecraft_version} <${minecraft_next}",
		"sodium": "0.9.x",
		"fabric-key-mapping-api-v1": "*",
		"fabric-lifecycle-events-v1": "*"
	},
	"custom": {
		"sodium:options": {
			"mixin.features.render.world.sky": false
		}
	}
}
